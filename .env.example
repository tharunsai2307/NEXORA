# Root environment variables for Edge-AI-Based Smart Building Digital Twin System
# Copy this file to .env and adjust variables as required

# Environment
APP_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_building_db
DB_USER=smart_admin
DB_PASSWORD=smart_building_secure_pass_2026

# Java Spring Boot Backend Configuration
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Python FastAPI AI Service Configuration
AI_SERVICE_HOST=localhost
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000

# React Frontend Configuration
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
