# =============================================================================
# NEXORA — Environment Configuration Template
# System: Edge-AI-Based Smart Building Safety and Occupancy Digital Twin System
# Instructions: Copy this file to '.env' and adjust values for your environment.
# Note: NEVER commit the active '.env' file containing real secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Environment & Deployment Mode
# -----------------------------------------------------------------------------
# Options: development, staging, production
APP_ENV=production
# Options: dev, standalone, prod (Spring profile)
SPRING_PROFILES_ACTIVE=prod

# -----------------------------------------------------------------------------
# 2. Host Port Bindings
# -----------------------------------------------------------------------------
# Port exposed on host for web browser access (serves Nginx SPA + Proxied APIs)
FRONTEND_PORT=80

# Ports below are exposed only when using docker-compose.dev.yml overlay
BACKEND_PORT=8080
AI_SERVICE_PORT=8000
DB_PORT=5432

# -----------------------------------------------------------------------------
# 3. PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
# Hostname inside Docker bridge network: 'postgres'; for standalone: 'localhost'
DB_HOST=postgres
DB_NAME=smart_building_db
DB_USER=smart_admin
# In production, replace with a strong, randomly generated password
DB_PASSWORD=change_this_to_a_secure_database_password_in_production_2026

# -----------------------------------------------------------------------------
# 4. Java Spring Boot Backend Configuration
# -----------------------------------------------------------------------------
# Secret key for HMAC-SHA256 JWT generation (minimum 256 bits / 32 characters)
JWT_SECRET=change_this_to_a_minimum_32_character_random_hex_or_string_key_2026!
# Token expiration in milliseconds (default: 86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# CORS Whitelist (comma-separated origins allowed to access backend directly)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://127.0.0.1

# -----------------------------------------------------------------------------
# 5. Python FastAPI AI Engine Configuration
# -----------------------------------------------------------------------------
# Internal URL used by Java backend to communicate with Python ML service
AI_SERVICE_URL=http://ai-service:8000

# -----------------------------------------------------------------------------
# 6. React Frontend Configuration (Vite)
# -----------------------------------------------------------------------------
# Leave empty for production (Nginx automatically routes relative '/api/v1' calls)
VITE_API_BASE_URL=
# Leave empty for production (browser connects to current host '/ws-raw')
VITE_WS_URL=
